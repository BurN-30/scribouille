# Environnement et cache Python
.venv/
__pycache__/
*.pyc

# Produits de construction. Le fichier packaging/scribouille.spec, lui, est versionné :
# c'est la recette, pas un résultat.
build/
dist/
packaging/sortie/

# Propre au poste : chemins locaux, préférences, secrets
config.json
jeton_hf.txt
# Vocabulaire de l'utilisateur (format 2) et propositions apprises : des noms
# de personnes et de sociétés, jamais dans le dépôt.
vocabulaire.toml
vocabulaire.toml.tmp
vocabulaire-propositions-*.toml
vocabulaire-propositions-*-chiffres.txt
*-format1-sauvegarde.txt
dossier-modeles.txt
gabarit-ia.txt

# Produits par l'application
logs/
modeles/
reprises/
# Séparation des locuteurs installée depuis l'application, et son cache de
# téléchargement. Plusieurs gigaoctets de bibliothèques, jamais versionnés.
extensions/
cache-pip/
# Moteur OpenVINO installé depuis l'application, ses compilés mis en cache,
# roues déposées pour une installation hors ligne, rapports du banc d'essai.
extensions-openvino/
cache-openvino/
paquets-hors-ligne/
rapports-banc/
# Comparaisons des moteurs : contiennent des transcriptions, jamais dans le dépôt.
comparaisons/
maj-etat.json
# Matériel détecté (cartes, NPU, périphériques d'OpenVINO), propre au poste.
materiel.json
materiel.json.tmp
surveillance-vus.json
calibration.json
_ffmpeg/

# Système
Thumbs.db
desktop.ini
.DS_Store

# Campagne de mesure : transcriptions du corpus et des réunions, corpus préparé.
campagnes/
corpus-campagne/
corpus-campagne-v*.zip
